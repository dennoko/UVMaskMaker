/* ============================================================
   MaskMakerStyles.uss
   MaskMaker ツール固有のスタイル。
   DennokoTheme.uss と併せてルート (.dennoko-root) にロードする。

   【規約】セレクタは必ず .dennoko-root を前置し、
   カラーは var(--dennoko-*) 変数を経由する。
   ============================================================ */

/* ─── プレビュー領域 ─────────────────────────────────────── */

/* プレビュー viewport (UVPreviewElement)。
   ズーム時にはみ出す描画内容は overflow: hidden でクリップする */
.dennoko-root .maskmaker-preview-viewport {
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--dennoko-surface-0);
}

/* 解析前に viewport 中央へ表示するヒントテキスト */
.dennoko-root .maskmaker-preview-hint {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    color: var(--dennoko-text-tertiary);
    font-size: 11px;
}

/* プレビュー上下のツールバー (dennoko-toolbar と併用)。縮小時に潰さない */
.dennoko-root .maskmaker-preview-toolbar {
    flex-shrink: 0;
}

/* ツールバー内の小型ボタン */
.dennoko-root .unity-button.maskmaker-toolbar-btn {
    font-size: 10px;
    padding: 2px 8px;
    margin: 1px 2px;
}

/* ツールバー内のズーム倍率表示 */
.dennoko-root .maskmaker-zoom-label {
    color: var(--dennoko-text-tertiary);
    font-size: 10px;
    -unity-text-align: middle-right;
    min-width: 40px;
}

/* フッターのブラシサイズスライダー */
.dennoko-root .maskmaker-brush-slider {
    width: 110px;
    margin: 0 4px;
}

/* ─── 汎用レイアウト ─────────────────────────────────────── */

/* 横並び行 (IMGUI の BeginHorizontal 相当) */
.dennoko-root .maskmaker-row {
    flex-direction: row;
    align-items: center;
}

/* 右寄せ用スペーサー (FlexibleSpace 相当) */
.dennoko-root .maskmaker-spacer {
    flex-grow: 1;
}

/* row 内で幅いっぱいに広げるフィールド。
   ⚠ flex-grow だけでは、フィールド内部の内容幅 (ObjectField のオブジェクト名等) が
   行幅を超えたときに縮まず、右へはみ出す。min-width: 0 と flex-shrink: 1 を併記して
   「内容幅より小さくなれる」ようにする。 */
.dennoko-root .maskmaker-grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* row 内フィールドの入力部も同様に縮小可能にし、あふれた表示はクリップする */
.dennoko-root .maskmaker-row .unity-base-field__input {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

/* 長いオブジェクト名でフィールド幅が押し広げられないよう省略表示にする */
.dennoko-root .unity-object-field-display__label {
    overflow: hidden;
    text-overflow: ellipsis;
}

/* row 内のボタン (Clear / ... ) は縮小させず、はみ出しはフィールド側で吸収する */
.dennoko-root .maskmaker-row > .unity-button {
    flex-shrink: 0;
}

/* 中央寄せの row (モード切替ボタン等) */
.dennoko-root .maskmaker-row--center {
    justify-content: center;
}

/* row 内に直接置くラベル (Write Channels 等)。カード内フィールドのラベル幅に揃える */
.dennoko-root .maskmaker-inline-label {
    min-width: 110px;
    flex-shrink: 0;
}

/* 幅を固定するモード切替ボタン (Add / Remove) */
.dennoko-root .unity-button.maskmaker-mode-btn {
    width: 100px;
}

/* ─── スプリットビューの各ゾーン ─────────────────────────── */

.dennoko-root .maskmaker-preview-zone {
    min-height: 80px;
}

.dennoko-root .maskmaker-settings-zone {
    min-height: 50px;
}

/* ─── ドラッグ&ドロップ領域 ─────────────────────────────── */

.dennoko-root .maskmaker-drop-area {
    background-color: var(--dennoko-surface-0);
    border-color: var(--dennoko-outline);
    border-width: 1px;
    border-radius: 4px;
    padding: 8px;
    margin: 2px 0 6px 0;
    -unity-text-align: middle-center;
    color: var(--dennoko-text-tertiary);
    font-size: 10px;
}

.dennoko-root .maskmaker-drop-area--hover {
    border-color: var(--dennoko-semantic-info);
    color: var(--dennoko-text-secondary);
}

/* ─── カード内フィールドのラベル幅を揃える ───────────────── */

.dennoko-root .dennoko-card .unity-base-field__label {
    min-width: 110px;
    flex-basis: 110px;
    flex-shrink: 0;
}

/* RGBA チャンネルトグルのような小さなトグルはラベル幅を持たせない */
.dennoko-root .maskmaker-channel-toggle .unity-base-field__label {
    min-width: 20px;
    flex-basis: 20px;
}

/* row 内でフィールドと横並びにするトグル (Invert Mask 等)。
   カード規則のラベル幅 110px を持たせるとフィールドと合わせて行幅を超えるため、
   ラベルはテキスト分の幅だけにし、自身は縮ませない */
.dennoko-root .maskmaker-inline-toggle {
    flex-shrink: 0;
    margin-left: 8px;
}

.dennoko-root .maskmaker-inline-toggle .unity-base-field__label {
    min-width: 0;
    flex-basis: auto;
}

/* ─── スプリッター (TwoPaneSplitView) ────────────────────── */

/* 分割ビュー自体を伸ばす */
.dennoko-root .unity-two-pane-split-view {
    flex-grow: 1;
}

/* ドラッグライン (掴めるバー) の配色 */
.dennoko-root .unity-two-pane-split-view__dragline-anchor {
    background-color: var(--dennoko-outline);
}

.dennoko-root .unity-two-pane-split-view__dragline-anchor--vertical {
    height: 4px;
}

/* ─── Foldout セクション見出し (Advanced 系) ─────────────── */

.dennoko-root .maskmaker-foldout {
    margin: 0 8px 6px 8px;
}

.dennoko-root .maskmaker-foldout > .unity-foldout__toggle .unity-toggle__text {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--dennoko-text-tertiary);
}

/* ─── アップデートチェック リロードボタン ─────────────────── */

.dennoko-root .dennoko-version-reload-button {
    width: 18px;
    height: 18px;
    margin-left: 4px;
    padding: 0;
    font-size: 12px;
    color: var(--dennoko-text-tertiary);
}
.dennoko-root .dennoko-version-reload-button:hover {
    color: var(--dennoko-text-primary);
}

/* ─── 対象モデル設定セクションの余白調整 ─────────────────── */

/* 最初のカードが上部境界と密着するのを防ぐため、上マージンを追加 */
.dennoko-root #target-card {
    margin-top: 10px;
}

